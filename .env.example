# Public monitor feed sources (comma-separated RSS/Atom URLs)
# Example: MONITOR_FEED_URLS=https://feed.example.com/rss.xml,https://another.example.com/feed.atom
MONITOR_FEED_URLS=

# Zamantika public profile API (for the default source)
ZAMANTIKA_PROFILE_API_URL=https://zamantika.com/api/twitter/profile/ibamarief

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_me
SUPABASE_SECRET_KEY=replace_me

# Protect the cron endpoint. Vercel Cron or GitHub Actions send this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace_me

# Simple dashboard password. Change it.
DASHBOARD_PASSWORD=replace_me

# Web Push VAPID keys. Generate with:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
VAPID_SUBJECT=mailto:you@example.com

# Optional: comma-separated extra keywords.
EXTRA_KEYWORDS=ibamarief,decryption,key,release key,passphrase,archive,hash,checksum,dead man's switch,emergency release
